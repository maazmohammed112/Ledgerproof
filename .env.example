# LedgerProof Environment Configuration

# Backend API Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# Optional AI LLM Provider Configuration
# LedgerProof includes robust deterministic multi-agent models out of the box.
# To connect to live external models, provide an OpenAI or Gemini compatible API key:
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# GEMINI_API_KEY=

# Observability Configuration
# Optional: Neatlogs integration endpoint
NEATLOGS_API_KEY=
NEATLOGS_ENDPOINT=https://api.neatlogs.io/v1/traces

# Storage Mode (browser-local IndexedDB persistence for hackathon demo)
STORAGE_MODE=browser-local
